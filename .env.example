# Copie este arquivo para .env e preencha com seus dados.
# O token de acesso fica no painel do Mercado Pago em:
# Developers > Credenciais de produção (ou teste)

# Token de acesso da aplicação (APP_USR-xxx ou TEST-xxx)
MERCADO_PAGO_ACCESS_TOKEN=

# URL pública da loja. Em produção, use o domínio real (ex: https://minhaloja.com.br).
# Necessário para o Mercado Pago notificar a loja (webhook) e para imagens dos produtos.
# Em desenvolvimento local, mantenha http://localhost:3000
PUBLIC_URL=http://localhost:3000
